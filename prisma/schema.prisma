generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Olt {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  mappings  Mapping[]
  ports     Port[]
}

model Port {
  id         Int       @id @default(autoincrement())
  oltId      Int
  slot       Int
  portNumber Int
  status     String    @default("available")
  label      String?
  brand      String?
  mappings   Mapping[]
  olt        Olt       @relation(fields: [oltId], references: [id])

  @@unique([oltId, slot, portNumber])
}

model Edfa {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  mappings Mapping[]
}

model Chasis {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  divisores Divisor[]
  mappings  Mapping[]
}

model Divisor {
  id       Int       @id @default(autoincrement())
  chasisId Int
  slot     Int
  type     String?
  chasis   Chasis    @relation(fields: [chasisId], references: [id])
  mappings Mapping[]

  @@unique([chasisId, slot])
}

model Odf {
  id        Int       @id @default(autoincrement())
  odfNumber String    @unique
  name      String?
  ports     OdfPort[]
}

model OdfPort {
  id       Int       @id @default(autoincrement())
  odfId    Int
  number   Int?
  buffer   Int
  color    String
  mappings Mapping[]
  odf      Odf       @relation(fields: [odfId], references: [id])

  @@unique([odfId, buffer, color])
}

model Mapping {
  id             Int      @id @default(autoincrement())
  portId         Int
  odfPortId      Int
  oltId          Int
  chasisId       Int?
  divisorId      Int?
  edfaId         Int?
  edfaComPort    String?
  edfaPonPort    String?
  entrada        String?
  feeder         String?
  splitterOutput String?
  chasis         Chasis?  @relation(fields: [chasisId], references: [id])
  divisor        Divisor? @relation(fields: [divisorId], references: [id])
  edfa           Edfa?    @relation(fields: [edfaId], references: [id])
  odfPort        OdfPort  @relation(fields: [odfPortId], references: [id])
  olt            Olt      @relation(fields: [oltId], references: [id])
  port           Port     @relation(fields: [portId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}
